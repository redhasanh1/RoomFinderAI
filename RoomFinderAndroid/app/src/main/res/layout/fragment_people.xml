<?xml version="1.0" encoding="utf-8"?>
<!--
  People: the two halves of the marketplace that are about persons rather than
  properties. Subleases and RoomPal share this slot, exactly as they do on iOS.

  The switcher is a filled pill row, not a segmented control, because the
  RoomPal half has a segmented control of its own; two grey segmented rows
  stacked would read as one confusing four-way choice.

  This replaces the Student Housing screen, which no longer exists on the site
  and has no iOS counterpart.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/peopleRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ios_grouped_background"
        android:orientation="vertical">

        <TextView
            android:id="@+id/peopleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/gutter"
            android:paddingTop="14dp"
            android:paddingBottom="12dp"
            android:text="Subleases"
            android:textAppearance="@style/Text.Display" />

        <!-- Which section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/gutter"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeSubleases"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Subleases"
                android:textSize="14sp"
                app:cornerRadius="23dp"
                app:icon="@drawable/ic_bookmark"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeRoommates"
                style="@style/Widget.Material3.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="RoomPal"
                android:textSize="14sp"
                app:cornerRadius="23dp"
                app:icon="@drawable/ic_people"
                app:iconGravity="textStart"
                app:iconSize="18dp" />

        </LinearLayout>

        <!-- Which of these: only the RoomPal half has two sides -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/roommateKindGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/gutter"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSeeking"
                style="@style/Widget.RoomFinder.IosChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Looking for a room" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHasSpot"
                style="@style/Widget.RoomFinder.IosChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Has a room" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/peopleCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="@dimen/gutter"
            android:text=""
            android:textAppearance="@style/Text.Footnote" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peopleRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp"
                android:scrollbars="vertical" />

            <ProgressBar
                android:id="@+id/peopleProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/peopleEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.3"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people"
                    app:tint="@color/purple_primary" />

                <TextView
                    android:id="@+id/peopleEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Nobody here yet"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/peopleEmptyBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Be the first to post"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
