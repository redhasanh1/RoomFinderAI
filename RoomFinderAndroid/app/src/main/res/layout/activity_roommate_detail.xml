<?xml version="1.0" encoding="utf-8"?>
<!--
  Who this person is, before you message them.

  Mirrors RoommateDetailScreen on iOS. Android had no equivalent at all: the
  People tab listed people and tapping one did nothing useful, so the only way
  to judge whether somebody was worth contacting was the two lines that fit on
  the card.

  Sections hide when empty rather than showing a heading over nothing. Most of
  these profiles are sparse, and a screen of empty headings reads as broken
  rather than as a profile with little in it.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/roommateScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar. Back sits on the left where the system gesture also
                 goes, so the two agree. -->
            <LinearLayout
                android:id="@+id/roommateTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp">

                <ImageButton
                    android:id="@+id/roommateBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ink" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/roommateOverflow"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More options"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/ink" />
            </LinearLayout>

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="20dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp">

                    <TextView
                        android:id="@+id/roommateInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar_circle"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="26sp" />

                    <ImageView
                        android:id="@+id/roommateAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/roommateName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/roommateKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/ios_pill_background"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/purple_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/roommateBudget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- About -->
            <LinearLayout
                android:id="@+id/roommateAboutSection"
                style="@style/RoommateSection"
                android:visibility="gone">

                <TextView style="@style/RoommateSectionHeading" android:text="About" />

                <TextView
                    android:id="@+id/roommateBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Details -->
            <LinearLayout
                android:id="@+id/roommateDetailsSection"
                style="@style/RoommateSection">

                <TextView style="@style/RoommateSectionHeading" android:text="Details" />

                <TextView android:id="@+id/roommateRowStatus" style="@style/RoommateDetailRow" />
                <TextView android:id="@+id/roommateRowBudget" style="@style/RoommateDetailRow" />
                <TextView android:id="@+id/roommateRowArea" style="@style/RoommateDetailRow" />
                <TextView
                    android:id="@+id/roommateRowMoveIn"
                    style="@style/RoommateDetailRow"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Their room -->
            <LinearLayout
                android:id="@+id/roommateRoomSection"
                style="@style/RoommateSection"
                android:visibility="gone">

                <TextView style="@style/RoommateSectionHeading" android:text="Their room" />

                <TextView
                    android:id="@+id/roommateRoomDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Docked, because messaging is the only thing this screen is for. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/roommateMessageButton"
        style="@style/Widget.RoomFinder.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:text="Message them"
        android:textSize="16sp"
        app:cornerRadius="14dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
