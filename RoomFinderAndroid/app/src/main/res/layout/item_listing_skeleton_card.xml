<?xml version="1.0" encoding="utf-8"?>
<!--
  Loading placeholder shaped like the real room card.

  A spinner on an empty page tells you to wait; a skeleton tells you what is
  coming and stops the layout jumping when it arrives. Same 20dp radius, same
  210dp photo block, same two lines of text underneath.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/gutter"
    android:layout_marginBottom="18dp"
    android:backgroundTint="@color/surface_card"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="3dp"
    app:strokeColor="#0A000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@color/surface_sunken" />

        <View
            android:layout_width="180dp"
            android:layout_height="15dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/skeleton_bar" />

        <View
            android:layout_width="110dp"
            android:layout_height="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/skeleton_bar" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
