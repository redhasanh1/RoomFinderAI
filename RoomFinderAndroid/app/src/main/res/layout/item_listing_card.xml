<?xml version="1.0" encoding="utf-8"?>
<!--
  Room card.

  Photo-led, the way a marketplace card should be: a tall image with a dark
  scrim at its foot, the price as a light pill over the photo, the save button
  in a translucent circle, and quiet type underneath. The previous version put
  a flat photo above three bold lines and read as a form, not a listing.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/gutter"
    android:layout_marginBottom="18dp"
    android:backgroundTint="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="3dp"
    app:strokeColor="#0A000000"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/listingImage"
            android:layout_width="0dp"
            android:layout_height="210dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/imageContainer"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:background="@drawable/photo_scrim"
            app:layout_constraintBottom_toBottomOf="@id/listingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/price_pill"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="$1,200/mo"
            android:textColor="@color/ink"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="@id/listingImage"
            app:layout_constraintStart_toStartOf="@id/listingImage" />

        <TextView
            android:id="@+id/verifiedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/verified_pill_dark"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="Verified"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_check_circle"
            app:drawableTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/listingImage"
            app:layout_constraintEnd_toEndOf="@id/listingImage" />

        <ImageButton
            android:id="@+id/favoriteButton"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_margin="12dp"
            android:background="@drawable/photo_action_circle"
            android:contentDescription="@string/app_name"
            android:elevation="3dp"
            android:padding="9dp"
            android:src="@drawable/favorite_button_selector"
            app:layout_constraintTop_toTopOf="@id/listingImage"
            app:layout_constraintEnd_toEndOf="@id/listingImage" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/listingImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Modern Apartment"
                android:textAppearance="@style/Text.Headline" />

            <TextView
                android:id="@+id/locationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:drawablePadding="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Downtown Edmonton"
                android:textAppearance="@style/Text.Footnote"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/ink_tertiary" />

            <TextView
                android:id="@+id/bedBathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="2 bd"
                android:textAppearance="@style/Text.Footnote" />

            <TextView
                android:id="@+id/propertyTypeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="gone" />

            <TextView
                android:id="@+id/availableStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
