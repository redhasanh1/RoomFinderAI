<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_background"
    android:orientation="vertical">

    <!-- Header with Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/post_listing_title"
            android:textAppearance="@style/Text.Title" />

        <!-- Progress Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/stepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1 of 4"
                android:textAppearance="@style/Text.Caption" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/completionPercentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25% Complete"
                android:textAppearance="@style/Text.Caption"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:progress="25"
            android:max="100"
            android:progressTint="@color/purple_primary"
            android:progressBackgroundTint="@color/gray_200" />

        <!-- Step Title -->
        <TextView
            android:id="@+id/stepTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="The basics"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/stepDescription"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tell us about the place"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Content Container -->
    <FrameLayout
        android:id="@+id/stepContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Step 1: Basic Information -->
        <ScrollView
            android:id="@+id/step1Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!--
                  The AI route, first. Writing the description is where people
                  abandon posting a room, so the fastest path is offered before
                  the form rather than buried on step three.
                -->
                <LinearLayout
                    android:id="@+id/aiDraftBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/ios_hero_gradient"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01"
                            android:text="Let AI write it"
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.92"
                            android:text="Add one photo and it fills in the title, rent and description"
                            android:textColor="@color/white"
                            android:textSize="12.5sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_photo"
                        app:tint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aiStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/ai_status_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/aiStatusSpinner"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="@color/brand" />

                    <ImageView
                        android:id="@+id/aiStatusDone"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="gone"
                        app:tint="@color/brand" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/aiStatusTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Reading your photo"
                            android:textColor="@color/ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/aiStatusDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Working out the title, rent and description"
                            android:textAppearance="@style/Text.Footnote" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Property Type Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Type of place"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:text="Choose one then continue to property title"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/propertyTypeChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipApartment"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apartment" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHouse"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="House" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCondo"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Condo" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStudio"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Studio" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Title -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/titleInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.RoomFinder.TextInputLayout"
                    app:helperText="e.g., 'Spacious 2BR apartment in downtown'"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/titleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Title"
                        android:maxLength="100" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Location -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/locationInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.RoomFinder.TextInputLayout"
                    app:helperText="Renters search by area"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/locationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Address"
                        android:inputType="textPostalAddress" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Price -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/priceInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.RoomFinder.TextInputLayout"
                    app:helperText="Monthly rent amount"
                    app:helperTextEnabled="true"
                    app:prefixText="$">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/priceInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Monthly rent"
                        android:inputType="numberDecimal" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/priceSuggestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Similar properties rent for $1200-1500/month"
                    android:textColor="@color/purple_primary"
                    android:textSize="12sp"
                    android:background="@drawable/rounded_background"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

        <!-- Step 2: Property Details -->
        <ScrollView
            android:id="@+id/step2Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Bedrooms Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bedrooms *"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/bedroomsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStudioBed"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Studio" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1Bed"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip2Bed"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip3Bed"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip4PlusBed"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4+" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Bathrooms Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bathrooms *"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/bathroomsChipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip1Bath"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip15Bath"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.5" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip2Bath"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip25Bath"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.5" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip3PlusBath"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3+" />

                </com.google.android.material.chip.ChipGroup>

                <!-- Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/descriptionInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.RoomFinder.TextInputLayout"
                    app:helperText="Describe amenities, location benefits, and unique features"
                    app:helperTextEnabled="true"
                    app:counterEnabled="true"
                    app:counterMaxLength="500">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/descriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Description"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:maxLength="500"
                        android:gravity="top" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/writeForMeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:text="Write it for me"
                    android:textColor="@color/purple_primary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_ai_assistant_vector"
                    app:iconGravity="textStart"
                    app:iconTint="@color/purple_primary"
                    app:strokeColor="#59667EEA" />

            </LinearLayout>

        </ScrollView>

        <!-- Step 3: Photos -->
        <ScrollView
            android:id="@+id/step3Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photos"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Three or more photos get more enquiries. The first one is the cover."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="16dp" />

                <!-- Photo Upload Area -->
                <LinearLayout
                    android:id="@+id/photoUploadArea"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/search_bar_background"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_add"
                        android:tint="@color/purple_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to add photos"
                        android:textColor="@color/purple_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Camera or Gallery"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Photo Counter -->
                <TextView
                    android:id="@+id/photoCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 / 10 photos added"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="16dp" />

                <!-- Photos Preview Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/photosRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </ScrollView>

        <!-- Step 4: Review -->
        <ScrollView
            android:id="@+id/step4Container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review Your Listing"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Preview Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/previewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Title"
                            android:textSize="18sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/previewDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 bed • 1 bath • $1200/month"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:id="@+id/previewLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previousButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Previous"
            android:visibility="gone"
            style="@style/Widget.RoomFinder.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next: details"
            style="@style/Widget.RoomFinder.Button" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/postButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Post Listing"
            android:visibility="gone"
            style="@style/Widget.RoomFinder.Button" />

    </LinearLayout>

</LinearLayout>