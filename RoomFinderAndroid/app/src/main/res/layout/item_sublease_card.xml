<?xml version="1.0" encoding="utf-8"?>
<!-- A sublease post: who wants what, where, when, and for how much. Dates lead
     because a sublease is defined by its window. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/gutter"
    android:layout_marginBottom="14dp"
    android:backgroundTint="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="3dp"
    app:strokeColor="#0A000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- A pill has to hug its text. This was 0dp with weight 1, so the
                 badge stretched to fill the row and drew as a long empty bar
                 with three words at the left end - obvious on a tablet, where
                 the card is wide. The spacer below does the pushing instead. -->
            <TextView
                android:id="@+id/subleaseType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/kind_pill"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="Offering a sublease"
                android:textColor="@color/purple_primary"
                android:textSize="11sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/subleasePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="$1,200/mo"
                android:textColor="@color/ink"
                android:textSize="17sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/subleaseLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="Toronto, Ontario"
            android:textAppearance="@style/Text.Headline"
            app:drawableStartCompat="@drawable/ic_location"
            app:drawableTint="@color/ink_tertiary" />

        <TextView
            android:id="@+id/subleaseDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Jul 3 – Nov 14  ·  6 months"
            android:textAppearance="@style/Text.Footnote" />

        <TextView
            android:id="@+id/subleaseSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Apartment · Furnished"
            android:textAppearance="@style/Text.Footnote" />

        <TextView
            android:id="@+id/subleaseDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
