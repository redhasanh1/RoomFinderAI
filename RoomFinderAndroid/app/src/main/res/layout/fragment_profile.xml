<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/enhanced_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Signed out.

              iOS shows the account form itself here, titled "Account" - no
              marketing. This screen used to open with a full-bleed gradient
              hero and four "what you can do with RoomFinder" cards, and put
              Sign in below all of it, so the one thing a signed-out person came
              for was the last thing they could reach.
            -->
            <LinearLayout
                android:id="@+id/guestView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="14dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account"
                    android:textAppearance="@style/Text.Display" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sign in to message landlords and save rooms."
                    android:textAppearance="@style/Text.Body.Secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Sign in"
                    android:textSize="16sp"
                    app:backgroundTint="@color/brand"
                    app:cornerRadius="@dimen/control_radius" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/signupButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Create account"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    app:cornerRadius="@dimen/control_radius"
                    app:strokeColor="@color/separator_strong" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/separator" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:text="or"
                        android:textAppearance="@style/Text.Footnote" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/separator" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/googleButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Continue with Google"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    app:cornerRadius="@dimen/control_radius"
                    app:icon="@drawable/ic_google"
                    app:iconGravity="textStart"
                    app:iconTint="@null"
                    app:strokeColor="@color/separator_strong" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="10dp"
                    android:text="With an account"
                    android:textAppearance="@style/Text.Caption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:paddingVertical="11dp"
                    android:text="Message landlords directly"
                    android:textAppearance="@style/Text.Body"
                    app:drawableStartCompat="@drawable/ic_chat"
                    app:drawableTint="@color/ink_tertiary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/separator" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:paddingVertical="11dp"
                    android:text="Save rooms you like"
                    android:textAppearance="@style/Text.Body"
                    app:drawableStartCompat="@drawable/ic_favorite_border"
                    app:drawableTint="@color/ink_tertiary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/separator" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="12dp"
                    android:paddingVertical="11dp"
                    android:text="Post a room of your own"
                    android:textAppearance="@style/Text.Body"
                    app:drawableStartCompat="@drawable/ic_add"
                    app:drawableTint="@color/ink_tertiary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/browseAsGuestButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Keep browsing without an account"
                    android:textColor="@color/ink_secondary" />

            </LinearLayout>

            <!--
              Signed in.

              iOS keeps this to a list: who you are, your listings, the few
              things only this screen offers, then the destructive pair. The
              Android version had a 2x2 "Quick Actions" grid whose Messages and
              AI Assistant cards were the Messages tab, plus a Tools card and a
              row of counters that repeated the rows underneath them - four ways
              to reach two places.
            -->
            <LinearLayout
                android:id="@+id/userView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp"
                    android:text="Profile"
                    android:textAppearance="@style/Text.Display" />

                <!-- Identity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:id="@+id/userAvatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/avatar_circle"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:tint="@color/white" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/userName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="John Doe"
                            android:textAppearance="@style/Text.Headline" />

                        <TextView
                            android:id="@+id/userEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="john@example.com"
                            android:textAppearance="@style/Text.Footnote" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/savedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 saved"
                                android:textAppearance="@style/Text.Caption" />

                            <TextView
                                android:id="@+id/postedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="0 posted"
                                android:textAppearance="@style/Text.Caption" />

                            <TextView
                                android:id="@+id/messagesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="0 messages"
                                android:textAppearance="@style/Text.Caption" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/separator" />

                <!-- Your listings -->
                <TextView
                    android:id="@+id/yourListingsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"
                    android:text="Your listings"
                    android:textAppearance="@style/Text.Title"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recentListingsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingBottom="6dp" />

                <LinearLayout
                    android:id="@+id/myListingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingVertical="15dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home"
                        app:tint="@color/ink_tertiary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Manage my listings"
                        android:textAppearance="@style/Text.Body" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/gutter"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/savedPropertiesCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingVertical="15dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="@color/ink_tertiary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Saved rooms"
                        android:textAppearance="@style/Text.Body" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/gutter"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/settingsItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingVertical="15dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/ink_tertiary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Settings"
                        android:textAppearance="@style/Text.Body" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="@dimen/gutter"
                    android:background="@color/separator" />

                <LinearLayout
                    android:id="@+id/helpItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/gutter"
                    android:paddingVertical="15dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/ink_tertiary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Help and support"
                        android:textAppearance="@style/Text.Body" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/separator" />

                <!-- Destructive, kept apart from everything else -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/logoutButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="@dimen/gutter"
                    android:layout_marginTop="26dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Sign out"
                    android:textColor="@color/ink"
                    app:cornerRadius="@dimen/control_radius"
                    app:strokeColor="@color/separator_strong" />

                <TextView
                    android:id="@+id/deleteAccountItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:text="Delete account"
                    android:textColor="@color/negative"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/gutter"
                    android:text="Deleting removes your account, your listings and your saved rooms for good."
                    android:textAppearance="@style/Text.Caption" />

                <!-- Kept so existing bindings resolve; these are tabs now. -->
                <View
                    android:id="@+id/messagesCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/aiAssistantCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/toolsCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>