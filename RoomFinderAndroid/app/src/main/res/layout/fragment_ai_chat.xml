<?xml version="1.0" encoding="utf-8"?>
<!--
  AI Negotiator.

  Rebuilt against the iOS NegotiatorScreen. An empty transcript now shows the
  primer - what the thing is, in one sentence, and three prompts you can tap -
  instead of a blank void with a floating input, which is what a first-time user
  used to be handed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_grouped_background"
    android:orientation="vertical">

    <!-- Header: sits on the page, not in a coloured slab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Negotiator"
                android:textAppearance="@style/Text.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Finds rooms, argues the rent down"
                android:textAppearance="@style/Text.Footnote" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="More"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_secondary" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp" />

        <!-- Primer: shown while the transcript is empty -->
        <ScrollView
            android:id="@+id/negotiatorPrimer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/avatar_circle"
                    android:contentDescription="@null"
                    android:padding="18dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="Your rental advocate"
                    android:textAppearance="@style/Text.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Tell it what you're after. It finds rooms, works out what's a fair price, and negotiates with landlords for you."
                    android:textAppearance="@style/Text.Body.Secondary" />

                <TextView
                    android:id="@+id/suggestionOne"
                    style="@style/Widget.RoomFinder.Suggestion"
                    android:layout_marginTop="22dp"
                    android:text="Find me a 1 bedroom under $1500" />

                <TextView
                    android:id="@+id/suggestionTwo"
                    style="@style/Widget.RoomFinder.Suggestion"
                    android:text="What's a fair rent in Toronto?" />

                <TextView
                    android:id="@+id/suggestionThree"
                    style="@style/Widget.RoomFinder.Suggestion"
                    android:text="Help me negotiate my rent down" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

    <!-- Composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="10dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/composer_field"
            android:hint="Ask about rent, areas, or a listing"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="50dp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Send"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            app:backgroundTint="@color/purple_primary"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/white" />

    </LinearLayout>

</LinearLayout>
