<?xml version="1.0" encoding="utf-8"?>
<!--
  Home, laid out like the iOS ListingsScreen(showsHero: true, title: "Home").

  Order there is: large title, a compact gradient "Let the AI negotiate" banner,
  the search field with its filter button beside it, the category strip, then
  the grouped feed. The banner is deliberately a strip and not a full-viewport
  splash - on a browse screen the rooms are the point, and a hero that fills
  the screen just means scrolling past it every visit.

  The previous Android home led with a 280dp purple hero and a neon quick-tools
  carousel, which is what made the two apps look like different products.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ios_grouped_background">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_page"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <!-- Title and banner scroll away, as the iOS large title does. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:text="@string/nav_home"
                android:textAppearance="@style/Text.Display" />

            <!-- Opens the Messages tab, as the iOS banner does -->
            <LinearLayout
                android:id="@+id/heroBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginBottom="12dp"
                android:background="@drawable/ios_hero_gradient"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:text="Let the AI negotiate"
                        android:textColor="@color/white"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"
                        android:text="We argue the rent down for you"
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ai_assistant_vector"
                    app:tint="@color/white" />

            </LinearLayout>

            </LinearLayout>

            <!-- Search and categories stay put: they are the controls people
                 reach for while scrolling the feed. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/gutter"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_capsule"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="15dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/ink_tertiary" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search by city or neighbourhood"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageButton
                        android:id="@+id/clearSearchButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear search"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="@color/text_secondary" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sortButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="@dimen/gutter"
                    android:text="@string/sort"
                    android:textColor="@color/purple_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_filter"
                    app:iconGravity="textStart"
                    app:iconSize="17dp"
                    app:iconTint="@color/purple_primary"
                    app:strokeColor="@color/separator_strong"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingBottom="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipApartment"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apartment" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHouse"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="House" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCondo"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Condo" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStudio"
                        style="@style/Widget.RoomFinder.IosChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Studio" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- Four fixed chips in a plain row meant the last one ("Pet
                 friendly") was clipped to a single letter. -->
            <HorizontalScrollView
                android:id="@+id/popularSearchesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/gutter"
                android:paddingBottom="10dp"
                android:scrollbars="none"
                android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDowntown"
                    style="@style/Widget.RoomFinder.IosChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Downtown" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip2Bedroom"
                    style="@style/Widget.RoomFinder.IosChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="2 bedroom" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUnder1500"
                    style="@style/Widget.RoomFinder.IosChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Under $1500" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPetFriendly"
                    style="@style/Widget.RoomFinder.IosChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pet friendly" />

            </LinearLayout>

            </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/separator" />

            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:scrollbars="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emptyLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ios_grouped_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:alpha="0.35"
                android:contentDescription="@null"
                android:src="@drawable/house_3d_modern" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="No rooms found"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Try adjusting your search criteria"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ios_grouped_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Couldn't load rooms"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/purple_primary"
                android:text="Try Again"
                android:textColor="@color/white"
                app:cornerRadius="22dp" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
