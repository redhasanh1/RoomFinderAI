<?xml version="1.0" encoding="utf-8"?>
<!-- Widget styles matching the iOS app's components. -->
<resources>

    <!-- iOS FilterChipView: caption/medium, systemGray6 fill, hairline
         systemGray4 stroke, blue when selected. -->
    <style name="Widget.RoomFinder.IosChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/ios_chip_background</item>
        <item name="chipStrokeColor">@color/ios_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="android:textColor">@color/ios_chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStartPadding">10dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="rippleColor">@color/ios_gray5</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- A tappable prompt on the negotiator's primer. -->
    <style name="Widget.RoomFinder.Suggestion" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/suggestion_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">13dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- The selected tab's pill: brand at low opacity, not a solid lilac slab. -->
    <style name="TabBar.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/brand_soft</item>
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
    </style>

    <!-- A row in a bottom sheet. The active one carries a check on the end, so
         the sheet says what is already chosen rather than only offering. -->
    <style name="Widget.RoomFinder.SheetRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/gutter</item>
        <item name="android:paddingVertical">15dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
